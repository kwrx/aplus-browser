set(CMAKE_SYSTEM_NAME aplus)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_CROSSCOMPILING ON)

list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES APLUS_SDK_DIR APLUS_TOOLCHAIN)

if (NOT APLUS_TOOLCHAIN)
    find_program(APLUS_GCC x86_64-aplus-gcc REQUIRED)
    get_filename_component(APLUS_TOOLCHAIN "${APLUS_GCC}" DIRECTORY)
    get_filename_component(APLUS_TOOLCHAIN "${APLUS_TOOLCHAIN}" DIRECTORY)
endif ()

if (NOT APLUS_SDK_DIR)
    message(FATAL_ERROR "Set APLUS_SDK_DIR to the usr directory of the aplus sysroot")
endif ()

set(APLUS_TOOLCHAIN "${APLUS_TOOLCHAIN}" CACHE PATH "aplus cross toolchain")
set(APLUS_SDK_DIR "${APLUS_SDK_DIR}" CACHE PATH "aplus sysroot prefix")

set(CMAKE_C_COMPILER "${APLUS_TOOLCHAIN}/bin/x86_64-aplus-gcc")
set(CMAKE_CXX_COMPILER "${APLUS_TOOLCHAIN}/bin/x86_64-aplus-g++")
set(CMAKE_AR "${APLUS_TOOLCHAIN}/bin/x86_64-aplus-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${APLUS_TOOLCHAIN}/bin/x86_64-aplus-ranlib" CACHE FILEPATH "")

get_filename_component(APLUS_SYSROOT "${APLUS_SDK_DIR}" DIRECTORY)
set(CMAKE_FIND_ROOT_PATH "${APLUS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")

set(APLUS_LIMITS_H "${APLUS_TOOLCHAIN}/x86_64-aplus/include/limits.h")
set(CMAKE_C_FLAGS_INIT "-D_GNU_SOURCE -include ${APLUS_LIMITS_H}")
set(CMAKE_CXX_FLAGS_INIT "-D_GNU_SOURCE -include ${APLUS_LIMITS_H} -DU_SHOW_CPLUSPLUS_HEADER_API=0")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -L${APLUS_SDK_DIR}/lib")

set(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "")
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "")
