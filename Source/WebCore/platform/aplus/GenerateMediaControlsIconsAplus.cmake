file(GLOB _icons "${INPUT_DIR}/*.svg" "${INPUT_DIR}/*.png")
list(SORT _icons)
set(_arrays "")
set(_entries "")
set(_index 0)
foreach (_icon IN LISTS _icons)
    get_filename_component(_name "${_icon}" NAME_WE)
    get_filename_component(_ext "${_icon}" EXT)
    string(SUBSTRING "${_ext}" 1 -1 _type)
    file(READ "${_icon}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _arrays "static const uint8_t icon${_index}[] = { ${_bytes} };\n")
    string(APPEND _entries "    { \"${_name}\"_s, \"${_type}\"_s, std::span<const uint8_t> { icon${_index} } },\n")
    math(EXPR _index "${_index} + 1")
endforeach ()
file(WRITE "${OUTPUT}.tmp" "#include \"config.h\"\n#include \"MediaControlsIconsAplus.h\"\n\nnamespace WebCore {\n\n${_arrays}\nstruct MediaControlsIconAplus {\n    ASCIILiteral name;\n    ASCIILiteral type;\n    std::span<const uint8_t> data;\n};\n\nstatic const MediaControlsIconAplus icons[] = {\n${_entries}};\n\nstd::span<const uint8_t> mediaControlsIconAplus(StringView name, StringView type)\n{\n    for (auto& icon : icons) {\n        if (name == icon.name && type == icon.type) {\n            return icon.data;\n        }\n    }\n    return { };\n}\n\n}\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
